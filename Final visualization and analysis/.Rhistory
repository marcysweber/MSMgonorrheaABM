viz_delay_care = function(df, n, max, min){
#Delay to Seek Care
return(ggplot(df) +
geom_histogram(aes(x = DelayToSeekCareMSM*365), color = "black", fill = "darkgrey", binwidth = 0.5, boundary = min*365) +
labs(x = "DelayToSeekCare in days",
y = "Count",
title = "G.") +
scale_x_continuous(breaks = seq(2,9,1), labels = seq(2, 9, 1))+
geom_vline(xintercept=min*365, linetype="dashed")+
geom_vline(xintercept=max*365, linetype="dashed")+
theme_bw())
}
visualize_parameters = function(df){
#InitialInfected
# a <- viz_initial_infected(df, 4, 5500, 4000)
#propHighRisk
b <- viz_prop_high_risk(df, 4, 0.35, 0.05)
c <- viz_transmission(df, 4, 20, 3.5)
d <- viz_recovery_time(df, 4, 20, 2.5)
e <- viz_prob_symptomatic(df, 4, 0.25, 0.1)
f <- viz_screen_interval_mean(df, 5, 3, 0.75)
f2 <- viz_screen_interval_var(df, 5, 3, 0.75)
g <- viz_delay_care(df,4, 0.02307692, 0.005479452)
max<-0.02307692
min <- 0.005479452
unit <- 1/365
#Delay to Retreatment
h<-ggplot(df) +
geom_histogram(aes(x = DelayToRetreatmentMSM), color = "black", fill = "darkgrey", binwidth = unit/2, boundary = min) +
labs(x = "DelayToRetreatmentMSM in days",
y = "Count",
title = "H.") +
scale_x_continuous(breaks = seq(2/365,9/365,1/365), labels = seq(2,9, unit*365))+
geom_vline(xintercept=min, linetype="dashed")+
geom_vline(xintercept=max, linetype="dashed")+
theme_bw()
#Assortativity
max<-1.0
min <- 0.5
n<-4
unit <- (max-min)/n
i<-ggplot(df) +
geom_histogram(aes(x = Assortativity), color = "black", fill = "darkgrey", binwidth = unit/2, boundary = min) +
labs(x = "Assortativity",
y = "Count",
title = "I.") +
scale_x_continuous(breaks = seq(min,max,unit), labels = seq(min,max, unit))+
geom_vline(xintercept=min, linetype="dashed")+
geom_vline(xintercept=max, linetype="dashed")+
theme_bw()
#riskGroupTransferProp
max<-0.1
min <- 0.01
unit <- (max-min)/n
j<-ggplot(df) +
geom_histogram(aes(x = activityGroupTransferProp), color = "black", fill = "darkgrey", binwidth = unit/2, boundary = min) +
labs(x = "activityGroupTransferProp",
y = "Count",
title = "J.") +
scale_x_continuous(breaks = seq(min,max,unit), labels = seq(min,max, unit))+
geom_vline(xintercept=min, linetype="dashed")+
geom_vline(xintercept=max, linetype="dashed")+
theme_bw()
#riskGroupTransmissionRatio
max<-0.5
min <- 0.05
unit <- (max-min)/n
k<-ggplot(df) +
geom_histogram(aes(x = activityGroupTransmissionRatio), color = "black", fill = "darkgrey", binwidth = unit/2, boundary = min) +
labs(x = "activityGroupTransmissionRatio",
y = "Count",
title = "K.") +
scale_x_continuous(breaks = seq(min,max,unit), labels = seq(min,max, unit))+
geom_vline(xintercept=min, linetype="dashed")+
geom_vline(xintercept=max, linetype="dashed")+
theme_bw()
max<- -3
min <- -6
unit <- (max-min)/n
l<-ggplot(df) +
geom_histogram(aes(x = ProbDevelopResistanceAExponent), color = "black", fill = "darkgrey", binwidth = unit/2, boundary = min) +
labs(x = "ProbDevelopResistAExp",
y = "Count",
title = "L.") +
scale_x_continuous(breaks = seq(min,max,unit), labels = seq(min,max, unit))+
geom_vline(xintercept=min, linetype="dashed")+
geom_vline(xintercept=max, linetype="dashed")+
theme_bw()
max<- -3
min <- -6
unit <- (max-min)/n
m<-ggplot(df) +
geom_histogram(aes(x = ProbDevelopResistanceBExponent), color = "black", fill = "darkgrey", binwidth = unit/2, boundary = min) +
labs(x = "ProbDevelopResistBExp",
y = "Count",
title = "L.") +
scale_x_continuous(breaks = seq(min,max,unit), labels = seq(min,max, unit))+
geom_vline(xintercept=min, linetype="dashed")+
geom_vline(xintercept=max, linetype="dashed")+
theme_bw()
return(multiplot(b,c,d,e,f,f2,g,h,i, j, k,l,m, cols = 3))
}
#load the sweep data, and give each run a unique identifier
#sweepdir <- "/Users/me597/Documents/MSMoutput/output_APRIL_7_2026_debug_2_sweep_none_0.0_0.0/" # e.g. "/Users/me597/Documents/MSMoutput/output_MARCH_31_2026_debug_1_sweep_none_0.0_0.0/"
sweepdir <- "/usr/local/MSMoutput/output_APRIL_10_2026_overnight_sweep_none_0.0_0.0/"
dfsweep <- read.csv(paste(sweepdir, "sweepnone0.00.0supercombined.csv", sep=''))
dfsweep$uniqueID <- as.integer(paste(as.character(dfsweep$RunNumber), as.character(dfsweep$seed), sep=''))
#calculate weights based on the 3 calibration targets, and resample w replacement
df_ends <- calc_weights(dfsweep)
df_best_ends <- resample(df_ends, 3000)
#save the resample so it can be re-accessed (includes duplicate entries)
#parcaldir <- "/Users/me597/Documents/MSM_parcalibrated_params/" #/Users/me597/Documents/MSM_parcalibrated_params/
parcaldir <- "/usr/local/MSM_parcalibrated_params/" #/Users/me597/Documents/MSM_parcalibrated_params/
write.csv(df_best_ends, file = paste(parcaldir, "resample_w_replicates_", today(), ".csv", sep=''))
#get the unique trajectories, so that duplicates do not need to be re-run
df_best_ends_unique <- data.frame(matrix(ncol=length(df_best_ends[1,]), nrow = 0)) #empty DF with all needed cols
colnames(df_best_ends_unique) <- colnames(df_best_ends) #copy over the col names
unique_resamples <- unique(df_best_ends$uniqueID) #get the vector of just uniqueIDs without duplicates
#populate the dataframe based on the uniqueID from the resamples
for (unique_ID in unique_resamples){ #use the unduplicated IDs to populate the new DF
newrow <- first(df_best_ends[df_best_ends$uniqueID == unique_ID,])
df_best_ends_unique <- rbind(df_best_ends_unique, newrow)
}
best_ends_unique <- identify(df_best_ends_unique, df_best_ends)
df_best_traj <- best_traj(dfsweep,df_best_ends_unique) #grabs all timesteps for the resampled trajs
df_best_traj <- identify(df_best_traj, df_best_ends) #removes duplicates and adds a col for times resampled
#write parcalibrated parameter sets to file
write_calibrated(df_best_ends_unique, parcaldir)
visualize_parameters(df_best_ends)
