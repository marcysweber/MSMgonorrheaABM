attempts_A = sum(df$AttemptTreatmentsA)
attempts_B = sum(df$AttemptTreatmentsB)
attempts_X = sum(df$AttemptTreatmentsX)
usage_E = sum(df$UsageofErtapenem)
return(attempts_A + attempts_B + attempts_X + usage_E)
}
