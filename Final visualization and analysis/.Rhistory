}
viz_screen_interval_var = function(df, n, max, min){
unit <- (max-min)/n
return(ggplot(df) +
geom_histogram(aes(x = ScreenIntervalVarMSM), color = "black", fill = "darkgrey", binwidth = unit/2, boundary = min) +
labs(x = "ScreenIntervalVarMSM",
y = "Count",
title = "F2.") +
scale_x_continuous(breaks = seq(min,max,unit), labels = seq(min,max, unit))+
