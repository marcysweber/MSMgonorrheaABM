calculate_calibration_fit <- function(posterior_samples,
empirical_point,
empirical_ci_lower = NULL,
empirical_ci_upper = NULL) {
# Posterior summary
post_mean <- mean(posterior_samples)
post_median <- median(posterior_samples)
post_sd <- sd(posterior_samples)
post_ci_95 <- quantile(posterior_samples, c(0.025, 0.975))
post_ci_50 <- quantile(posterior_samples, c(0.25, 0.75))
# Coverage checks
in_95ci <- empirical_point >= post_ci_95[1] & empirical_point <= post_ci_95[2]
in_50ci <- empirical_point >= post_ci_50[1] & empirical_point <= post_ci_50[2]
# Distance metrics
abs_error <- abs(empirical_point - post_mean)
rel_error <- (abs_error / empirical_point) * 100
# Posterior predictive p-value
ppp <- mean(posterior_samples >= empirical_point)
ppp_centered <- 2 * min(ppp, 1 - ppp)  # two-tailed version
# Z-score
z_score <- (empirical_point - post_mean) / post_sd
# CI overlap (if empirical CI provided)
if (!is.null(empirical_ci_lower) & !is.null(empirical_ci_upper)) {
overlap_lower <- max(empirical_ci_lower, post_ci_95[1])
overlap_upper <- min(empirical_ci_upper, post_ci_95[2])
if (overlap_upper > overlap_lower) {
overlap_width <- overlap_upper - overlap_lower
empirical_width <- empirical_ci_upper - empirical_ci_lower
ci_overlap_prop <- overlap_width / empirical_width
} else {
ci_overlap_prop <- 0
}
} else {
ci_overlap_prop <- NA
}
# Format posterior CIs as single strings
post_ci_95_formatted <- sprintf("(%.2f, %.2f)", post_ci_95[1], post_ci_95[2])
post_ci_50_formatted <- sprintf("(%.2f, %.2f)", post_ci_50[1], post_ci_50[2])
# Return results
results <- data.frame(
empirical_point = empirical_point,
posterior_mean = post_mean,
#posterior_median = post_median,
#posterior_sd = post_sd,
post_ci_95 = post_ci_95_formatted,
post_ci_50 = post_ci_50_formatted,
in_95_ci = in_95ci,
in_50_ci = in_50ci,
abs_error = abs_error,
relative_error_pct = rel_error,
z_score = z_score,
ppp_value = ppp,
#ppp_two_tailed = ppp_centered,
ci_overlap_proportion = ci_overlap_prop
)
return(results)
}
