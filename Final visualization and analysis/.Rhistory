fitnesspath <- "/Users/me597/Documents/MSMoutput/"
# Define fitness costs as a simple vector
fitness_costs <- c("0.0_0.0", "0.01_0.01", "0.025_0.025", "0.05_0.05", "0.0_0.1", "0.1_0.0", "0.1_0.1)
strategies <- list(
"GISP" = "GISPrand_05",
fitnesspath <- "/Users/me597/Documents/MSMoutput/"
# Define fitness costs as a simple vector
fitness_costs <- c("0.0_0.0", "0.01_0.01", "0.025_0.025", "0.05_0.05", "0.0_0.1", "0.1_0.0", "0.1_0.1")
strategies <- list(
"GISP" = "GISPrand_05",
"random" = "random",
"real" = "realistic_combo_50_50_00",
"TOC" = "test-of-cure_80"
)
# Loop through and create dataframes
for (cost_value in fitness_costs) {
cost_code <- str_replace_all(cost_value, "_", "")
dir_path <- paste0(fitnesspath, "output_MAY_06_2026_overnight_2_all_combo_", cost_value, "/")
for (strat_name in names(strategies)) {
strat_prefix <- strategies[[strat_name]]
# Build filename
filename <- paste0(strat_prefix, "combo", cost_value, "_1combined.csv")
filepath <- paste0(dir_path, filename)
# Create dataframe name (using cost_value directly)
df_name <- paste0("df", strat_name, "fitnessCost", cost_value)
# Read and assign to global environment
assign(df_name,
identify(read.csv(filepath), df_best_ends),
envir = .GlobalEnv)
}
}
