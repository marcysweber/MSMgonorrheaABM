prcc_arrange = function(df, outcome_col){
#for PRCC, each outcome needs its own df
#the only columns should be parameters for analysis + the one outcome
df <- get_ends(df)
new_df <- df[,12:34]
new_df <- cbind(new_df, df[,outcome_col])
return(new_df)
}
prcc = function(df, outcome_col){
epi.prcc(prcc_arrange(df, outcome_col))
}
prcc_prev = function(df){
return(prcc(df, 36))
}
prcc_inc = function(df){
return(prcc(df, 37))}
prcc_sympt = function(df){
return(prcc(df, 41))}
prcc_cost = function(df){
return(prcc(df, 80))}
prcc_qalys = function(df){
return(prcc(df, 81))}
prcc_all = function(df){
prevalence <- prcc_prev(df)
incidence <- prcc_inc(df)
symptomprop <- prcc_sympt(df)
monetaryCost <- prcc_cost(df)
qalys <- prcc_qalys(df)
return(list(prevalance=prevalence, incidence=incidence, symptomprop=symptomprop, monetaryCost=monetaryCost, QALYs=qalys))
}
combineddf <- rbind(dfGISP25, dfrandom25, dfTOC25, dfreal25)
prevalencePRCC <- prcc_prev(combineddf)
incidencePRCC <- prcc_inc(combineddf)
symptompropPRCC <- prcc_sympt(combineddf)
monetaryCostPRCC <- prcc_cost(combineddf)
qalysPRCC <- prcc_qalys(combineddf)
kable(prevalencePRCC[order(-abs(prevalencePRCC$est)),], caption = "Prevalence PRCC")
kable(incidencePRCC[order(-abs(incidencePRCC$est)),], caption = "Incidence PRCC")
kable(symptompropPRCC[order(-abs(symptompropPRCC$est)),], caption = "Symptomatic Proportion PRCC")
kable(monetaryCostPRCC[order(-abs(monetaryCostPRCC$est)),], caption = "Costs PRCC")
kable(qalysPRCC[order(-abs(qalysPRCC$est)),], caption = "QALYs PRCC")
fitnesspath <- "/usr/local/MSMoutput/"
# Define fitness costs as a simple vector
fitness_costs <- c("0.0_0.0", "0.0_0.1", "0.1_0.0", "0.1_0.1", "0.1_0.25", "0.5_0.5", "0.5_0.25", "0.25_0.1", "0.25_0.5", "0.25_0.25")
strategies <- list(
"GISP" = "GISPrand_05",
"random" = "random",
"real" = "realistic_combo_50_50_00",
"TOC" = "test-of-cure_80"
)
# Loop through and create dataframes
for (cost_value in fitness_costs) {
cost_code <- str_replace_all(cost_value, "_", "")
dir_path <- paste0(fitnesspath, "JAN_12_2026_overnight_all_combo_", cost_value, "/")
for (strat_name in names(strategies)) {
strat_prefix <- strategies[[strat_name]]
# Build filename
filename <- paste0(strat_prefix, "combo", cost_code, "1combined.csv")
filepath <- paste0(dir_path, filename)
# Create dataframe name (using cost_value directly)
df_name <- paste0("df", strat_name, "fitnessCost", cost_value)
# Read and assign to global environment
assign(df_name,
identify(read.csv(filepath), df_best_ends),
envir = .GlobalEnv)
}
}
